# Image is a policy of the H3 DiT. No image-specific transformer stack is linked.
add_executable(strix-h3-image apps/h3_image_main.cpp)
target_link_libraries(strix-h3-image PRIVATE strix_h3_block_ref strix_h3_vae_host)
find_package(PNG QUIET)
if(PNG_FOUND)
    target_link_libraries(strix-h3-image PRIVATE PNG::PNG)
    target_compile_definitions(strix-h3-image PRIVATE STRIX_H3_IMAGE_PNG=1)
endif()
if(TARGET strix_h3_dist_hip AND TARGET strix_h3_te_gpu AND TARGET strix_h3_vae_device)
    set_source_files_properties(apps/h3_image_main.cpp PROPERTIES LANGUAGE HIP)
    target_link_libraries(strix-h3-image PRIVATE strix_h3_dist_hip strix_h3_te_gpu strix_h3_vae_device)
    target_compile_definitions(strix-h3-image PRIVATE STRIX_H3_IMAGE_HIP=1)
    set_target_properties(strix-h3-image PROPERTIES HIP_STANDARD 20 HIP_STANDARD_REQUIRED ON HIP_ARCHITECTURES "${STRIX_HIP_ARCHS}")
endif()
if(BUILD_TESTING)
    add_executable(strix-h3-image-pair-tests tests/h3/image/pair_tests.cpp)
    target_link_libraries(strix-h3-image-pair-tests PRIVATE strix_h3_dist_ref strix_h3_vae_host)
    add_test(NAME strix-h3-image-pair-tests COMMAND strix-h3-image-pair-tests)
    set_tests_properties(strix-h3-image-pair-tests PROPERTIES LABELS "h3;cpu" TIMEOUT 120)
    add_executable(strix-h3-image-checkpoint-tests tests/h3/image/checkpoint_tests.cpp)
    target_link_libraries(strix-h3-image-checkpoint-tests PRIVATE strix_h3_block_ref)
    find_package(Python3 COMPONENTS Interpreter QUIET)
    if(Python3_Interpreter_FOUND)
        add_test(NAME strix-h3-image-pair-cli COMMAND "${Python3_EXECUTABLE}"
            "${CMAKE_CURRENT_SOURCE_DIR}/tests/h3/image/test_pair_cli.py" --binary $<TARGET_FILE:strix-h3-image>)
        set_tests_properties(strix-h3-image-pair-cli PROPERTIES LABELS "h3;cpu" TIMEOUT 30)
        add_test(NAME strix-h3-image-checkpoint-reference COMMAND "${Python3_EXECUTABLE}"
            "${CMAKE_CURRENT_SOURCE_DIR}/tests/h3/image/test_checkpoints.py" --binary $<TARGET_FILE:strix-h3-image-checkpoint-tests>)
        set_tests_properties(strix-h3-image-checkpoint-reference PROPERTIES LABELS "h3;cpu" TIMEOUT 120)
    endif()
    add_executable(strix-h3-image-host-tests tests/h3/image/host_tests.cpp)
    target_link_libraries(strix-h3-image-host-tests PRIVATE strix_h3_block_ref strix_h3_vae_host strix_h3_te)
    add_test(NAME strix-h3-image-host-tests COMMAND strix-h3-image-host-tests)
    set_tests_properties(strix-h3-image-host-tests PROPERTIES LABELS "h3;cpu" TIMEOUT 120)
    set(H3_IMAGE_POSITION_FIXTURE "" CACHE FILEPATH "Private generated image geometry fixture")
    if(H3_IMAGE_POSITION_FIXTURE)
        add_test(NAME strix-h3-image-position-reference COMMAND strix-h3-image-host-tests "${H3_IMAGE_POSITION_FIXTURE}")
        set_tests_properties(strix-h3-image-position-reference PROPERTIES LABELS "h3;cpu" TIMEOUT 120)
    endif()
endif()
