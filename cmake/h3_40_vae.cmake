# MiniMax H3 video VAE decoder (36-layer ViT3D, tiled + temporal chunks): host reference + plan/blending
# (CPU, any host), GAN-vocoder audio decoder, and the HIP decoders (gfx1151). Data: H3_VAE_FIXTURES, H3_VAE_WEIGHTS,
# H3_AUDIO_VAE_WEIGHTS; plain tests report SKIPPED without them, the "qualification" label tests fail.
add_library(strix_h3_vae_host STATIC src/h3/vae/vae_io.cpp src/h3/vae/vae_plan.cpp src/h3/vae/vae_ref.cpp
    src/h3/vae/vae_host_decode.cpp src/h3/vae/vae_shard.cpp src/h3/vae/audio_ref.cpp
    src/h3/vae/enc_ref.cpp)
target_link_libraries(strix_h3_vae_host PUBLIC strix_h3_common Threads::Threads)
if(MSVC)
    target_compile_definitions(strix_h3_vae_host PUBLIC _CRT_SECURE_NO_WARNINGS)
    target_compile_options(strix_h3_vae_host PUBLIC /fp:strict)
endif()
if(BUILD_TESTING)
    add_executable(strix-h3-vae-host-tests tests/h3/vae/vae_host_tests.cpp)
    target_link_libraries(strix-h3-vae-host-tests PRIVATE strix_h3_vae_host)
    add_test(NAME strix-h3-vae-host-tests COMMAND strix-h3-vae-host-tests --quick)
    set_tests_properties(strix-h3-vae-host-tests PROPERTIES TIMEOUT 600 LABELS "h3;cpu")
    add_executable(strix-h3-audio-host-tests tests/h3/vae/audio_host_tests.cpp)
    target_link_libraries(strix-h3-audio-host-tests PRIVATE strix_h3_vae_host)
    add_test(NAME strix-h3-audio-host-tests COMMAND strix-h3-audio-host-tests)
    set_tests_properties(strix-h3-audio-host-tests PROPERTIES TIMEOUT 600 LABELS "h3;cpu")
    add_test(NAME strix-h3-audio-host-qualify COMMAND strix-h3-audio-host-tests --require)
    set_tests_properties(strix-h3-audio-host-qualify PROPERTIES TIMEOUT 600 LABELS "h3;cpu;qualification")
    add_executable(strix-h3-enc-host-tests tests/h3/vae/enc_host_tests.cpp)
    target_link_libraries(strix-h3-enc-host-tests PRIVATE strix_h3_vae_host)
    add_test(NAME strix-h3-enc-host-tests COMMAND strix-h3-enc-host-tests)
    set_tests_properties(strix-h3-enc-host-tests PROPERTIES TIMEOUT 600 LABELS "h3;cpu")
    add_test(NAME strix-h3-enc-host-qualify COMMAND strix-h3-enc-host-tests --require)
    set_tests_properties(strix-h3-enc-host-qualify PROPERTIES TIMEOUT 600 LABELS "h3;cpu;qualification")
    # qualification: fails when H3_VAE_FIXTURES / H3_VAE_WEIGHTS are missing (select with -L qualification)
    add_test(NAME strix-h3-vae-host-qualify COMMAND strix-h3-vae-host-tests --require)
    set_tests_properties(strix-h3-vae-host-qualify PROPERTIES TIMEOUT 900 LABELS "h3;cpu;qualification")
endif()
if(STRIX_ENABLE_HIP_RUNTIME)
    add_library(strix_h3_vae_device STATIC src/h3/vae/vae_kernels.hip src/h3/vae/vae_decoder.hip src/h3/vae/audio_decoder.hip
        src/h3/vae/enc_gpu.hip src/h3/vae/fast_decoder.hip)
    target_link_libraries(strix_h3_vae_device PUBLIC strix_h3_vae_host "${STRIX_HIP_RUNTIME_LIBRARY}")
    target_include_directories(strix_h3_vae_device PUBLIC "${STRIX_HIP_INCLUDE_DIR}")
    set(strix_h3_vae_hip_targets strix_h3_vae_device)
    if(BUILD_TESTING)
        add_executable(strix-h3-vae-gpu-tests tests/h3/vae/vae_gpu_tests.hip)
        target_link_libraries(strix-h3-vae-gpu-tests PRIVATE strix_h3_vae_device)
        list(APPEND strix_h3_vae_hip_targets strix-h3-vae-gpu-tests)
        # GPU qualification (needs a gfx1151 device, H3_VAE_WEIGHTS and H3_VAE_FIXTURES; fails without them):
        # excluded from a plain host run with -LE gpu
        add_test(NAME strix-h3-vae-gpu-qualify COMMAND strix-h3-vae-gpu-tests)
        set_tests_properties(strix-h3-vae-gpu-qualify PROPERTIES TIMEOUT 470 LABELS "h3;gpu;qualification")
        add_executable(strix-h3-audio-gpu-tests tests/h3/vae/audio_gpu_tests.hip)
        target_link_libraries(strix-h3-audio-gpu-tests PRIVATE strix_h3_vae_device)
        list(APPEND strix_h3_vae_hip_targets strix-h3-audio-gpu-tests)
        add_test(NAME strix-h3-audio-gpu-qualify COMMAND strix-h3-audio-gpu-tests)
        add_executable(strix-h3-enc-gpu-tests tests/h3/vae/enc_gpu_tests.hip)
        target_link_libraries(strix-h3-enc-gpu-tests PRIVATE strix_h3_vae_device)
        list(APPEND strix_h3_vae_hip_targets strix-h3-enc-gpu-tests)
        add_test(NAME strix-h3-enc-gpu-qualify COMMAND strix-h3-enc-gpu-tests)
        add_executable(strix-h3-fast-gpu-tests tests/h3/vae/fast_gpu_tests.hip)
        target_link_libraries(strix-h3-fast-gpu-tests PRIVATE strix_h3_vae_device)
        list(APPEND strix_h3_vae_hip_targets strix-h3-fast-gpu-tests)
        add_test(NAME strix-h3-fast-gpu-qualify COMMAND strix-h3-fast-gpu-tests)
        set_tests_properties(strix-h3-fast-gpu-qualify PROPERTIES TIMEOUT 470 LABELS "h3;gpu;qualification;lever")
        set_tests_properties(strix-h3-enc-gpu-qualify PROPERTIES TIMEOUT 470 LABELS "h3;gpu;qualification")
        set_tests_properties(strix-h3-audio-gpu-qualify PROPERTIES TIMEOUT 470 LABELS "h3;gpu;qualification")
    endif()
    foreach(target ${strix_h3_vae_hip_targets})
        set_target_properties(${target} PROPERTIES HIP_STANDARD 20 HIP_STANDARD_REQUIRED ON HIP_ARCHITECTURES "${STRIX_HIP_ARCHS}")
        target_compile_options(${target} PRIVATE -mno-wavefrontsize64 -fno-fast-math -ffp-contract=off
            -fhip-fp32-correctly-rounded-divide-sqrt -fdenormal-fp-math=ieee)
    endforeach()
endif()
