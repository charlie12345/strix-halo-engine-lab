# H3 K1: dense non-causal flash attention (head dim 128), split-KV partials and canonical merge.
add_library(strix_h3_attn_ref STATIC src/h3/attn/attn_ref.cpp)
target_link_libraries(strix_h3_attn_ref PUBLIC strix_h3_common)
strix_target_warnings(strix_h3_attn_ref)
if(BUILD_TESTING)
    add_executable(strix-h3-attn-host-tests tests/h3/attn/attn_host_tests.cpp)
    target_link_libraries(strix-h3-attn-host-tests PRIVATE strix_h3_attn_ref)
    strix_target_warnings(strix-h3-attn-host-tests)
    add_test(NAME strix-h3-attn-host-tests COMMAND strix-h3-attn-host-tests)
    set_tests_properties(strix-h3-attn-host-tests PROPERTIES TIMEOUT 120 LABELS "h3")
endif()
if(STRIX_ENABLE_HIP_RUNTIME)
    option(STRIX_H3_ATTN_RESOURCE_REMARKS "Print kernel resource usage (VGPR, LDS, scratch) of the H3 attention kernels" OFF)
    add_library(strix_h3_attn STATIC src/h3/attn/attn.hip)
    target_link_libraries(strix_h3_attn PUBLIC strix_h3_common "${STRIX_HIP_RUNTIME_LIBRARY}")
    target_include_directories(strix_h3_attn PUBLIC "${STRIX_HIP_INCLUDE_DIR}")
    set_source_files_properties(tests/h3/attn/attn_gpu_tests.cpp PROPERTIES LANGUAGE HIP)
    add_executable(strix-h3-attn-gpu-tests tests/h3/attn/attn_gpu_tests.cpp)
    target_link_libraries(strix-h3-attn-gpu-tests PRIVATE strix_h3_attn strix_h3_attn_ref)
    foreach(target strix_h3_attn strix-h3-attn-gpu-tests)
        set_target_properties(${target} PROPERTIES HIP_STANDARD 20 HIP_STANDARD_REQUIRED ON HIP_ARCHITECTURES "${STRIX_HIP_ARCHS}")
        target_compile_options(${target} PRIVATE -mno-wavefrontsize64 -fno-fast-math -ffp-contract=off
            -fhip-fp32-correctly-rounded-divide-sqrt -fdenormal-fp-math=ieee)
    endforeach()
    # GPU test in CTest only on request (needs a gfx1151 GPU): -DSTRIX_H3_GPU_CTEST=ON, label h3-gpu.
    option(STRIX_H3_GPU_CTEST "Register the H3 GPU tests in CTest" OFF)
    if(BUILD_TESTING AND STRIX_H3_GPU_CTEST)
        add_test(NAME strix-h3-attn-gpu-tests COMMAND strix-h3-attn-gpu-tests)
        set_tests_properties(strix-h3-attn-gpu-tests PROPERTIES TIMEOUT 400 LABELS "gpu;h3;h3-gpu")
        foreach(bad "STRIX_H3_ATTN_TUNE=7" "STRIX_H3_ATTN_PINGPONG=1x" "STRIX_H3_ATTN_EARLY=" "STRIX_H3_ATTN_WAVES=12")
            string(MAKE_C_IDENTIFIER "${bad}" bad_id)
            add_test(NAME strix-h3-attn-env-${bad_id} COMMAND strix-h3-attn-gpu-tests --env-check)
            set_tests_properties(strix-h3-attn-env-${bad_id} PROPERTIES TIMEOUT 60 LABELS "gpu;h3;h3-gpu" ENVIRONMENT "${bad}")
        endforeach()
    endif()
    if(STRIX_H3_ATTN_RESOURCE_REMARKS)
        target_compile_options(strix_h3_attn PRIVATE -Rpass-analysis=kernel-resource-usage)
    endif()
endif()
