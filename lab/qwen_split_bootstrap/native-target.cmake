if(NOT TARGET strix_hip_runtime OR NOT TARGET strix_dist)
  message(FATAL_ERROR "Copied Qwen model route requires the actual project HIP runtime and project host transports")
endif()
if(NOT STRIX_QWEN_COPIED_ROUTE_SOURCE MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "STRIX_QWEN_COPIED_ROUTE_SOURCE must be the frozen full source commit")
endif()
string(LENGTH "${STRIX_QWEN_COPIED_ROUTE_SOURCE}" source_length)
if(NOT source_length EQUAL 40)
  message(FATAL_ERROR "STRIX_QWEN_COPIED_ROUTE_SOURCE must contain exactly 40 hex digits")
endif()
add_library(strix-hip-qwen-copied-model-route STATIC "${CMAKE_CURRENT_LIST_DIR}/../../src/hip_copied_host_sequence.cpp")
target_link_libraries(strix-hip-qwen-copied-model-route PUBLIC strix_hip_runtime strix_dist)
target_compile_features(strix-hip-qwen-copied-model-route PUBLIC cxx_std_20)
target_compile_definitions(strix-hip-qwen-copied-model-route PRIVATE STRIX_QWEN_COPIED_ROUTE_SOURCE="${STRIX_QWEN_COPIED_ROUTE_SOURCE}")
strix_target_warnings(strix-hip-qwen-copied-model-route)
