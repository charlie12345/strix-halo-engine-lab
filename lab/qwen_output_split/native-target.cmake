if(NOT TARGET strix_hip_runtime OR NOT TARGET strix_dist)
  message(FATAL_ERROR "Output split fixture needs STRIX_ENABLE_HIP_RUNTIME=ON")
endif()
string(LENGTH "${STRIX_SPLIT_SOURCE_SHA}" _split_sha_length)
if(NOT _split_sha_length EQUAL 40 OR NOT STRIX_SPLIT_SOURCE_SHA MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Pass the actual full STRIX_SPLIT_SOURCE_SHA for this clean source packet")
endif()
add_executable(strix-qwen-output-split-native "${CMAKE_CURRENT_LIST_DIR}/native.cpp")
target_compile_features(strix-qwen-output-split-native PRIVATE cxx_std_20)
target_link_libraries(strix-qwen-output-split-native PRIVATE strix_hip_runtime strix_dist)
target_compile_definitions(strix-qwen-output-split-native PRIVATE STRIX_SPLIT_SOURCE_SHA="${STRIX_SPLIT_SOURCE_SHA}")
if(MSVC)
  target_compile_options(strix-qwen-output-split-native PRIVATE /fp:strict)
else()
  target_compile_options(strix-qwen-output-split-native PRIVATE -ffp-contract=off)
endif()
strix_target_warnings(strix-qwen-output-split-native)
